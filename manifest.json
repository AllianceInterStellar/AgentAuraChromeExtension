{
    "manifest_version": 3,
    "name": "AgentAura - OpenClaw Manager",
    "version": "3.0.2",
    "description": "Deploy, manage, and automate OpenClaw from Chrome with AI chat, cloud controls, and browser actions.",
    "minimum_chrome_version": "137",
    "permissions": [
        "storage",
        "identity",
        "sidePanel",
        "scripting",
        "debugger",
        "tabGroups",
        "tabs",
        "alarms",
        "notifications",
        "downloads"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "js/background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "options_page": "pages/options.html",
    "commands": {
        "_execute_side_panel": {
            "suggested_key": {
                "default": "Alt+Shift+E"
            },
            "description": "Open AgentAura side panel"
        },
        "toggle-agent": {
            "suggested_key": {
                "default": "Alt+Shift+A"
            },
            "description": "Toggle agent mode"
        }
    }
}
